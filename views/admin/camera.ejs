<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
<script>
(function(){
    try {
        const s = JSON.parse(localStorage.getItem('yuraSettings') || '{}');
        if (s.darkMode === false) {
            const st = document.createElement('style');
            st.id = '__yuraLight';
            st.textContent = `
                body { background: #f0f2f5 !important; color: #111 !important; }
                .sidebar { background: #fff !important; border-color: rgba(0,0,0,0.1) !important; }
                .topbar { background: #fff !important; border-color: rgba(0,0,0,0.1) !important; }
                .main, .content { background: #f0f2f5 !important; }
                .cam-main, .info-card, .thumb { background: #fff !important; border-color: rgba(0,0,0,0.08) !important; }
                .nav-item { color: #555 !important; }
                .nav-item:hover { background: rgba(0,0,0,0.04) !important; color: #111 !important; }
                .nav-item.active { color: var(--rouge) !important; background: rgba(192,57,43,0.07) !important; }
                h1, h2, h3, .stat-val, .user-name-s { color: #111 !important; }
                .stat-lbl, .logo-sub, .user-role-s, .topbar-title, .card-label { color: #666 !important; }
                .topbar-user { background: rgba(192,57,43,0.07) !important; border-color: rgba(192,57,43,0.2) !important; }
                .robot-badge { background: rgba(192,57,43,0.07) !important; border-color: rgba(192,57,43,0.25) !important; }
                .ctrl-btn { background: rgba(0,0,0,0.05) !important; border-color: rgba(0,0,0,0.1) !important; color: #555 !important; }
            `;
            document.head.appendChild(st);
        }
        if (s.colorTheme === 'blue-black') {
            document.documentElement.style.setProperty('--rouge', '#2563eb');
            document.documentElement.style.setProperty('--rouge-light', '#3b82f6');
            document.documentElement.style.setProperty('--border', 'rgba(37,99,235,0.18)');
        } else if (s.colorTheme === 'green-black') {
            document.documentElement.style.setProperty('--rouge', '#16a34a');
            document.documentElement.style.setProperty('--rouge-light', '#22c55e');
            document.documentElement.style.setProperty('--border', 'rgba(22,163,74,0.18)');
        }
        if (!s.animations) {
            const na = document.createElement('style');
            na.id = '__noAnim';
            na.textContent = '* { animation: none !important; transition: none !important; }';
            document.head.appendChild(na);
        }
    } catch(e) {}
})();
</script>
<style>
:root {
    --rouge:#c0392b;
    --rouge-light:#e74c3c;
    --noir:#0a0a0a;
    --card:#111111;
    --card2:#161616;
    --border:rgba(192,57,43,0.18);
    --gris:#888;
    --gris2:#bbb;
}

* { margin:0; padding:0; box-sizing:border-box; }

body {
    font-family:'Segoe UI', sans-serif;
    background:var(--noir);
    color:#fff;
    display:flex;
    min-height:100vh;
}

/* ── SIDEBAR ── */
.sidebar {
    width:300px;
    min-height:100vh;
    background:#0d0d0d;
    border-right:1px solid var(--border);
    display:flex;
    flex-direction:column;
    position:fixed;
    top:0; left:0; bottom:0;
    z-index:100;
}

.logo-section { padding:20px 18px; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:14px; }
.logo-name { font-size:1.1rem; font-weight:800; color:#fff; letter-spacing:2px; }
.logo-sub { font-size:0.65rem; color:var(--gris); letter-spacing:2px; text-transform:uppercase; }
.admin-badge-side { margin:12px 16px 4px; padding:8px 14px; background:rgba(192,57,43,0.2); border:1px solid rgba(192,57,43,0.5); border-radius:6px; font-size:0.7rem; font-weight:800; color:var(--rouge-light); letter-spacing:2px; text-transform:uppercase; text-align:center; }
.robot-badge { margin:8px 16px 6px; padding:10px 16px; background:rgba(192,57,43,0.12); border:1px solid rgba(192,57,43,0.4); border-radius:8px; display:flex; align-items:center; gap:10px; font-size:0.75rem; font-weight:700; color:var(--rouge-light); }
.badge-dot { width:8px; height:8px; background:var(--rouge-light); border-radius:50%; animation:blink 1.2s infinite; flex-shrink:0; }
.nav-section { padding:8px 0; flex:1; overflow-y:auto; }
.nav-label { font-size:0.6rem; font-weight:700; color:var(--gris); letter-spacing:2px; padding:12px 18px 5px; text-transform:uppercase; }
.nav-item { display:flex; align-items:center; gap:13px; padding:11px 18px; color:#666; text-decoration:none; font-size:0.87rem; font-weight:500; border-left:2px solid transparent; transition:all 0.18s; }
.nav-item:hover { color:#fff; background:rgba(192,57,43,0.07); }
.nav-item.active { color:#fff; background:rgba(192,57,43,0.13); border-left-color:var(--rouge); font-weight:600; }
.nav-icon-wrap { width:20px; height:20px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.nav-text { flex:1; }
.nav-count { background:var(--rouge); color:#fff; font-size:0.6rem; font-weight:700; padding:2px 7px; border-radius:10px; }
.sidebar-footer { border-top:1px solid var(--border); padding:8px 0; }
.user-row { display:flex; align-items:center; gap:10px; padding:11px 18px; }
.user-av { width:34px; height:34px; background:linear-gradient(135deg,var(--rouge),#7b241c); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:0.85rem; font-weight:700; flex-shrink:0; }
.user-name-s { font-size:0.82rem; font-weight:600; color:#fff; }
.user-role-s { font-size:0.65rem; color:var(--rouge-light); font-weight:600; }

/* ── MAIN ── */
.main {
    flex:1;
    margin-left:300px;
    display:flex;
    flex-direction:column;
    min-height:100vh;
}

/* ── TOPBAR ── */
.topbar {
    height:52px;
    background:#0d0d0d;
    border-bottom:1px solid var(--border);
    display:flex;
    align-items:center;
    padding:0 24px;
    gap:12px;
    position:sticky;
    top:0;
    z-index:50;
}
.topbar-right { display:flex; align-items:center; gap:10px; }
.topbar-bell { position:relative; cursor:pointer; text-decoration:none; display:flex; align-items:center; }
.bell-badge { position:absolute; top:-4px; right:-4px; width:16px; height:16px; background:var(--rouge); border-radius:50%; font-size:0.6rem; color:#fff; font-weight:700; display:flex; align-items:center; justify-content:center; }
.topbar-user { display:flex; align-items:center; gap:7px; background:rgba(192,57,43,0.12); border:1px solid rgba(192,57,43,0.35); padding:5px 14px; border-radius:20px; font-size:0.75rem; font-weight:700; color:var(--rouge-light); text-decoration:none; letter-spacing:0.5px; }
.user-dot { width:7px; height:7px; background:var(--rouge-light); border-radius:50%; }
.admin-pill { background:rgba(192,57,43,0.25); border:1px solid rgba(192,57,43,0.5); padding:4px 10px; border-radius:4px; font-size:0.62rem; font-weight:800; color:var(--rouge-light); letter-spacing:1.5px; text-transform:uppercase; }
.topbar-title { font-size:0.78rem; color:var(--gris); letter-spacing:1.5px; text-transform:uppercase; flex:1; }
.live-pill { display:flex; align-items:center; gap:6px; background:rgba(192,57,43,0.15); border:1px solid rgba(192,57,43,0.4); padding:4px 12px; border-radius:20px; font-size:0.7rem; font-weight:700; color:var(--rouge-light); letter-spacing:1px; }
.live-dot { width:6px; height:6px; background:var(--rouge-light); border-radius:50%; animation:blink 1s infinite; }

@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.2} }

/* ── CONTENT ── */
.content {
    padding:20px 24px;
    display:grid;
    grid-template-columns:1fr 300px;
    grid-template-rows:auto auto;
    gap:16px;
    flex:1;
}

/* ── CAMERA MAIN ── */
.cam-main {
    grid-column:1;
    grid-row:1;
    background:var(--card);
    border:1px solid var(--border);
    border-radius:12px;
    overflow:hidden;
}

.cam-header { display:flex; align-items:center; justify-content:space-between; padding:12px 16px; border-bottom:1px solid rgba(255,255,255,0.05); }
.cam-title { font-family:'Rajdhani', sans-serif; font-size:0.85rem; font-weight:600; letter-spacing:1.5px; color:var(--gris2); text-transform:uppercase; }
.cam-id { font-size:0.68rem; color:var(--rouge-light); background:rgba(192,57,43,0.1); border:1px solid rgba(192,57,43,0.25); padding:3px 8px; border-radius:4px; font-weight:600; letter-spacing:1px; }

.cam-feed {
    position:relative;
    width:100%;
    aspect-ratio:16/9;
    background:#000;
    overflow:hidden;
}

.cam-feed img {
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
    transition:filter 0.3s;
}

.cam-overlay-tl { position:absolute; top:12px; left:12px; display:flex; flex-direction:column; gap:6px; }
.cam-overlay-tr { position:absolute; top:12px; right:12px; display:flex; flex-direction:column; align-items:flex-end; gap:6px; }
.cam-overlay-bl { position:absolute; bottom:12px; left:12px; }
.cam-overlay-br { position:absolute; bottom:12px; right:12px; }

.overlay-tag { display:flex; align-items:center; gap:5px; background:rgba(0,0,0,0.7); border:1px solid rgba(255,255,255,0.1); padding:4px 10px; border-radius:4px; font-size:0.65rem; font-weight:700; letter-spacing:1px; backdrop-filter:blur(4px); }
.overlay-tag.red { border-color:rgba(192,57,43,0.5); color:var(--rouge-light); }
.overlay-tag.green { border-color:rgba(39,174,96,0.5); color:#27ae60; }
.overlay-tag.blue { border-color:rgba(59,130,246,0.5); color:#3b82f6; }

.corner { position:absolute; width:20px; height:20px; border-color:var(--rouge); border-style:solid; opacity:0.6; }
.corner-tl { top:8px; left:8px; border-width:2px 0 0 2px; }
.corner-tr { top:8px; right:8px; border-width:2px 2px 0 0; }
.corner-bl { bottom:8px; left:8px; border-width:0 0 2px 2px; }
.corner-br { bottom:8px; right:8px; border-width:0 2px 2px 0; }

/* ── CONTROLS ── */
.cam-controls { display:flex; align-items:center; gap:8px; padding:12px 16px; border-top:1px solid rgba(255,255,255,0.04); flex-wrap:wrap; }
.ctrl-btn { display:flex; align-items:center; gap:5px; padding:6px 12px; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08); border-radius:6px; color:var(--gris2); font-size:0.72rem; font-weight:500; cursor:pointer; transition:all 0.15s; font-family:'Inter', sans-serif; }
.ctrl-btn:hover { background:rgba(192,57,43,0.12); border-color:rgba(192,57,43,0.35); color:#fff; }
.ctrl-btn.active { background:rgba(192,57,43,0.2); border-color:rgba(192,57,43,0.5); color:var(--rouge-light); }
.ctrl-btn.danger { border-color:rgba(192,57,43,0.3); color:var(--rouge-light); }
.ctrl-sep { width:1px; height:20px; background:rgba(255,255,255,0.06); margin:0 2px; }

/* ── CAMERA GRID (thumbnails) ── */
.cam-grid {
    grid-column:1;
    grid-row:2;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
}

.thumb { background:var(--card); border:1px solid rgba(255,255,255,0.06); border-radius:8px; overflow:hidden; cursor:pointer; transition:all 0.15s; }
.thumb:hover { border-color:rgba(192,57,43,0.3); }
.thumb.active { border-color:var(--rouge); }
.thumb-feed { width:100%; aspect-ratio:16/9; background:#000; position:relative; overflow:hidden; }
.thumb-feed img { width:100%; height:100%; object-fit:cover; opacity:0.7; }
.thumb.active .thumb-feed img { opacity:1; }
.thumb-info { padding:6px 8px; display:flex; align-items:center; justify-content:space-between; }
.thumb-name { font-size:0.68rem; font-weight:600; color:var(--gris2); font-family:'Rajdhani', sans-serif; letter-spacing:1px; }
.thumb-status { width:6px; height:6px; border-radius:50%; background:#27ae60; }
.thumb-status.off { background:#333; }

/* ── RIGHT PANEL ── */
.right-panel { grid-column:2; grid-row:1 / 3; display:flex; flex-direction:column; gap:12px; }
.info-card { background:var(--card); border:1px solid rgba(255,255,255,0.06); border-radius:12px; padding:16px; }
.card-label { font-size:0.62rem; font-weight:700; color:var(--gris); text-transform:uppercase; letter-spacing:1.5px; margin-bottom:12px; font-family:'Rajdhani', sans-serif; }

.stat-row-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:8px; }
.stat-item { background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.05); border-radius:8px; padding:10px; }
.stat-lbl { font-size:0.6rem; color:var(--gris); text-transform:uppercase; letter-spacing:0.8px; margin-bottom:4px; }
.stat-val { font-size:1rem; font-weight:700; color:#fff; font-family:'Rajdhani', sans-serif; }
.stat-val.green { color:#27ae60; }
.stat-val.rouge { color:var(--rouge-light); }
.stat-val.blue  { color:#3b82f6; }
.stat-val.orange{ color:#f59e0b; }

.alert-item { display:flex; align-items:center; gap:10px; padding:8px 10px; border-radius:7px; margin-bottom:6px; font-size:0.75rem; border:1px solid transparent; }
.alert-item:last-child { margin-bottom:0; }
.alert-item.warn { background:rgba(245,158,11,0.07); border-color:rgba(245,158,11,0.2); color:#f59e0b; }
.alert-item.info { background:rgba(59,130,246,0.07); border-color:rgba(59,130,246,0.2); color:#3b82f6; }
.alert-item.ok   { background:rgba(39,174,96,0.07); border-color:rgba(39,174,96,0.2); color:#27ae60; }
.alert-dot { width:6px; height:6px; border-radius:50%; flex-shrink:0; background:currentColor; }

/* offline overlay */
.cam-offline-overlay {
    position:absolute;
    inset:0;
    background:rgba(0,0,0,0.75);
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:10px;
    font-size:0.85rem;
    color:#666;
    font-weight:600;
    letter-spacing:1px;
    display:none;
}
.cam-offline-overlay svg { opacity:0.3; }
</style>
</head>
<body>

