<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root {
    --rouge:#c0392b;
    --rouge-light:#e74c3c;
    --noir:#0a0a0a;
    --card:#0f0f0f;
    --card2:#141414;
    --border:rgba(192,57,43,0.2);
    --gris:#666;
    --gris2:#999;
}

* { margin:0; padding:0; box-sizing:border-box; }

body {
    font-family:'Inter', sans-serif;
    background:var(--noir);
    color:#fff;
    display:flex;
    min-height:100vh;
}

/* ── SIDEBAR ── */
.sidebar {
    width:260px;
    min-height:100vh;
    background:#080808;
    border-right:1px solid var(--border);
    display:flex;
    flex-direction:column;
    position:fixed;
    top:0; left:0; bottom:0;
    z-index:100;
    padding:24px 0;
}

.sidebar-logo {
    padding:0 20px 20px;
    border-bottom:1px solid var(--border);
    margin-bottom:16px;
}

.sidebar-logo h2 {
    font-family:'Rajdhani', sans-serif;
    font-size:1.4rem;
    font-weight:700;
    letter-spacing:3px;
    color:#fff;
}

.sidebar-logo span {
    font-size:0.6rem;
    color:var(--rouge-light);
    letter-spacing:2px;
    text-transform:uppercase;
}

.nav-item {
    display:flex;
    align-items:center;
    gap:10px;
    padding:10px 20px;
    color:var(--gris);
    text-decoration:none;
    font-size:0.82rem;
    font-weight:500;
    border-left:2px solid transparent;
    transition:all 0.15s;
}

.nav-item:hover { color:#fff; background:rgba(255,255,255,0.03); }
.nav-item.active { color:#fff; border-left-color:var(--rouge); background:rgba(192,57,43,0.08); }

/* ── MAIN ── */
.main {
    flex:1;
    margin-left:260px;
    display:flex;
    flex-direction:column;
    min-height:100vh;
}

/* ── TOPBAR ── */
.topbar {
    height:50px;
    background:#080808;
    border-bottom:1px solid var(--border);
    display:flex;
    align-items:center;
    padding:0 24px;
    gap:12px;
    position:sticky;
    top:0;
    z-index:50;
}

.topbar-title {
    font-family:'Rajdhani', sans-serif;
    font-size:1rem;
    font-weight:600;
    letter-spacing:2px;
    color:#fff;
    flex:1;
}

.live-pill {
    display:flex;
    align-items:center;
    gap:6px;
    background:rgba(192,57,43,0.15);
    border:1px solid rgba(192,57,43,0.4);
    padding:4px 12px;
    border-radius:20px;
    font-size:0.7rem;
    font-weight:700;
    color:var(--rouge-light);
    letter-spacing:1px;
}

.live-dot {
    width:6px; height:6px;
    background:var(--rouge-light);
    border-radius:50%;
    animation:blink 1s infinite;
}

@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.2} }

/* ── CONTENT ── */
.content {
    padding:20px 24px;
    display:grid;
    grid-template-columns:1fr 300px;
    grid-template-rows:auto auto;
    gap:16px;
    flex:1;
}

/* ── CAMERA MAIN ── */
.cam-main {
    grid-column:1;
    grid-row:1;
    background:var(--card);
    border:1px solid var(--border);
    border-radius:12px;
    overflow:hidden;
}

.cam-header {
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:12px 16px;
    border-bottom:1px solid rgba(255,255,255,0.05);
}

.cam-title {
    font-family:'Rajdhani', sans-serif;
    font-size:0.85rem;
    font-weight:600;
    letter-spacing:1.5px;
    color:var(--gris2);
    text-transform:uppercase;
}

.cam-id {
    font-size:0.68rem;
    color:var(--rouge-light);
    background:rgba(192,57,43,0.1);
    border:1px solid rgba(192,57,43,0.25);
    padding:3px 8px;
    border-radius:4px;
    font-weight:600;
    letter-spacing:1px;
}

.cam-feed {
    position:relative;
    width:100%;
    aspect-ratio:16/9;
    background:#000;
    overflow:hidden;
}

.cam-feed img {
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
}

.cam-overlay-tl {
    position:absolute;
    top:12px; left:12px;
    display:flex;
    flex-direction:column;
    gap:6px;
}

.cam-overlay-tr {
    position:absolute;
    top:12px; right:12px;
    display:flex;
    flex-direction:column;
    align-items:flex-end;
    gap:6px;
}

.cam-overlay-bl {
    position:absolute;
    bottom:12px; left:12px;
}

.cam-overlay-br {
    position:absolute;
    bottom:12px; right:12px;
}

.overlay-tag {
    display:flex;
    align-items:center;
    gap:5px;
    background:rgba(0,0,0,0.7);
    border:1px solid rgba(255,255,255,0.1);
    padding:4px 10px;
    border-radius:4px;
    font-size:0.65rem;
    font-weight:700;
    letter-spacing:1px;
    backdrop-filter:blur(4px);
}

.overlay-tag.red { border-color:rgba(192,57,43,0.5); color:var(--rouge-light); }
.overlay-tag.green { border-color:rgba(39,174,96,0.5); color:#27ae60; }
.overlay-tag.blue { border-color:rgba(59,130,246,0.5); color:#3b82f6; }

/* Corner brackets */
.corner {
    position:absolute;
    width:20px; height:20px;
    border-color:var(--rouge);
    border-style:solid;
    opacity:0.6;
}
.corner-tl { top:8px; left:8px; border-width:2px 0 0 2px; }
.corner-tr { top:8px; right:8px; border-width:2px 2px 0 0; }
.corner-bl { bottom:8px; left:8px; border-width:0 0 2px 2px; }
.corner-br { bottom:8px; right:8px; border-width:0 2px 2px 0; }

/* ── CONTROLS ── */
.cam-controls {
    display:flex;
    align-items:center;
    gap:8px;
    padding:12px 16px;
    border-top:1px solid rgba(255,255,255,0.04);
    flex-wrap:wrap;
}

.ctrl-btn {
    display:flex;
    align-items:center;
    gap:5px;
    padding:6px 12px;
    background:rgba(255,255,255,0.04);
    border:1px solid rgba(255,255,255,0.08);
    border-radius:6px;
    color:var(--gris2);
    font-size:0.72rem;
    font-weight:500;
    cursor:pointer;
    transition:all 0.15s;
    font-family:'Inter', sans-serif;
}

.ctrl-btn:hover {
    background:rgba(192,57,43,0.12);
    border-color:rgba(192,57,43,0.35);
    color:#fff;
}

.ctrl-btn.active {
    background:rgba(192,57,43,0.2);
    border-color:rgba(192,57,43,0.5);
    color:var(--rouge-light);
}

.ctrl-btn.danger {
    border-color:rgba(192,57,43,0.3);
    color:var(--rouge-light);
}

.ctrl-sep { width:1px; height:20px; background:rgba(255,255,255,0.06); margin:0 2px; }

/* ── CAMERA GRID ── */
.cam-grid {
    grid-column:1;
    grid-row:2;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
}

.thumb {
    background:var(--card);
    border:1px solid rgba(255,255,255,0.06);
    border-radius:8px;
    overflow:hidden;
    cursor:pointer;
    transition:all 0.15s;
}

.thumb:hover { border-color:rgba(192,57,43,0.3); }
.thumb.active { border-color:var(--rouge); }

.thumb-feed {
    width:100%;
    aspect-ratio:16/9;
    background:#000;
    position:relative;
    overflow:hidden;
}

.thumb-feed img {
    width:100%; height:100%;
    object-fit:cover;
    opacity:0.7;
}

.thumb.active .thumb-feed img { opacity:1; }

.thumb-info {
    padding:6px 8px;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.thumb-name {
    font-size:0.68rem;
    font-weight:600;
    color:var(--gris2);
    font-family:'Rajdhani', sans-serif;
    letter-spacing:1px;
}

.thumb-status {
    width:6px; height:6px;
    border-radius:50%;
    background:#27ae60;
}

.thumb-status.off { background:#333; }

/* ── RIGHT PANEL ── */
.right-panel {
    grid-column:2;
    grid-row:1 / 3;
    display:flex;
    flex-direction:column;
    gap:12px;
}

.info-card {
    background:var(--card);
    border:1px solid rgba(255,255,255,0.06);
    border-radius:12px;
    padding:16px;
}

.card-label {
    font-size:0.62rem;
    font-weight:700;
    color:var(--gris);
    text-transform:uppercase;
    letter-spacing:1.5px;
    margin-bottom:12px;
    font-family:'Rajdhani', sans-serif;
}

.stat-row {
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px;
    margin-bottom:8px;
}

.stat-item {
    background:rgba(255,255,255,0.03);
    border:1px solid rgba(255,255,255,0.05);
    border-radius:8px;
    padding:10px;
}

.stat-lbl { font-size:0.6rem; color:var(--gris); text-transform:uppercase; letter-spacing:0.8px; margin-bottom:4px; }
.stat-val { font-size:1rem; font-weight:700; color:#fff; font-family:'Rajdhani', sans-serif; }
.stat-val.green { color:#27ae60; }
.stat-val.rouge { color:var(--rouge-light); }
.stat-val.blue  { color:#3b82f6; }
.stat-val.orange{ color:#f59e0b; }

.alert-item {
    display:flex;
    align-items:center;
    gap:10px;
    padding:8px 10px;
    border-radius:7px;
    margin-bottom:6px;
    font-size:0.75rem;
    border:1px solid transparent;
}

.alert-item:last-child { margin-bottom:0; }
.alert-item.warn { background:rgba(245,158,11,0.07); border-color:rgba(245,158,11,0.2); color:#f59e0b; }
.alert-item.info { background:rgba(59,130,246,0.07); border-color:rgba(59,130,246,0.2); color:#3b82f6; }
.alert-item.ok   { background:rgba(39,174,96,0.07);  border-color:rgba(39,174,96,0.2);  color:#27ae60; }

.alert-dot { width:6px; height:6px; border-radius:50%; flex-shrink:0; background:currentColor; }
</style>
</head>

<body>

<!-- SIDEBAR -->
<div class="sidebar">
    <div class="sidebar-logo">
        <h2>YURA</h2>
        <span>Guardian System</span>
    </div>
    <a href="/admin/dashboard" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><rect x="1" y="1" width="6" height="6" rx="1"/><rect x="9" y="1" width="6" height="6" rx="1"/><rect x="1" y="9" width="6" height="6" rx="1"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg>
        Dashboard
    </a>
    <a href="/admin/users" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><circle cx="6" cy="5" r="3"/><path d="M0 14c0-3.3 2.7-6 6-6s6 2.7 6 6"/></svg>
        Utilisateurs
    </a>
    <a href="/admin/robot" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><rect x="4" y="2" width="8" height="6" rx="1"/><rect x="3" y="8" width="10" height="5" rx="1"/></svg>
        Contrôle Robot
    </a>
    <a href="/admin/history" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1a7 7 0 100 14A7 7 0 008 1zm0 2v5l3 3-1 1-3.5-3.5V3H8z"/></svg>
        Historique
    </a>
    <a href="/admin/camera" class="nav-item active">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M1 4a1 1 0 011-1h8a1 1 0 011 1v1.5l3-2v7l-3-2V12a1 1 0 01-1 1H2a1 1 0 01-1-1V4z"/></svg>
        Caméras
    </a>
    <a href="/admin/map" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M6 1l4 2 4-2v11l-4 2-4-2-4 2V3l4-2z"/></svg>
        Navigation
    </a>
    <a href="/admin/notifications" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1a5 5 0 00-5 5v3l-1.5 2.5h13L13 9V6a5 5 0 00-5-5zm0 14a2 2 0 01-2-2h4a2 2 0 01-2 2z"/></svg>
        Alertes
    </a>
    <a href="/admin/settings" class="nav-item">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M7.5 1l-.8 2.4a5 5 0 00-1.4.8L3 3.5l-1.5 2.6 1.9 1.5a5 5 0 000 1.8L1.5 11l1.5 2.6 2.3-.8a5 5 0 001.4.8L7.5 16h1l.8-2.4a5 5 0 001.4-.8l2.3.8L14.5 11l-1.9-1.5a5 5 0 000-1.8l1.9-1.5L13 3.5l-2.3.7a5 5 0 00-1.4-.8L8.5 1h-1z"/></svg>
        Paramètres
    </a>
</div>

<!-- MAIN -->
<div class="main">

    <!-- TOPBAR -->
    <div class="topbar">
        <span class="topbar-title">SURVEILLANCE CAMÉRAS</span>
        <div class="live-pill">
            <div class="live-dot"></div>
            LIVE
        </div>
    </div>

    <!-- CONTENT -->
    <div class="content">

        <!-- CAMERA MAIN -->
        <div class="cam-main">
            <div class="cam-header">
                <span class="cam-title">Flux Principal</span>
                <span class="cam-id" id="camLabel">CAM-01 — Entrée</span>
            </div>
            <div class="cam-feed" id="mainFeed">
                <img id="camStream" src="http://192.168.0.155:5000/video">
                <div class="corner corner-tl"></div>
                <div class="corner corner-tr"></div>
                <div class="corner corner-bl"></div>
                <div class="corner corner-br"></div>
                <div class="cam-overlay-tl">
                    <div class="overlay-tag red"><div class="live-dot"></div> REC LIVE</div>
                    <div class="overlay-tag blue" id="resTag">640×480</div>
                </div>
                <div class="cam-overlay-tr">
                    <div class="overlay-tag" id="timeTag">--:--:--</div>
                </div>
                <div class="cam-overlay-bl">
                    <div class="overlay-tag green" id="fpsTag">● SIGNAL OK</div>
                </div>
                <div class="cam-overlay-br">
                    <div class="overlay-tag" id="zoomTag">ZOOM 1.0×</div>
                </div>
            </div>
            <div class="cam-controls">
                <button class="ctrl-btn" onclick="zoomIn()">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="5" cy="5" r="4"/><line x1="8" y1="8" x2="11" y2="11"/><line x1="5" y1="3" x2="5" y2="7"/><line x1="3" y1="5" x2="7" y2="5"/></svg>
                    Zoom +
                </button>
                <button class="ctrl-btn" onclick="zoomOut()">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="5" cy="5" r="4"/><line x1="8" y1="8" x2="11" y2="11"/><line x1="3" y1="5" x2="7" y2="5"/></svg>
                    Zoom −
                </button>
                <div class="ctrl-sep"></div>
                <button class="ctrl-btn" onclick="takeSnapshot()">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="10" height="8" rx="1"/><circle cx="6" cy="7" r="2"/><path d="M4 3l1-2h2l1 2"/></svg>
                    Snapshot
                </button>
                <button class="ctrl-btn danger" onclick="toggleRecord()" id="recBtn">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="6" cy="6" r="4"/><circle cx="6" cy="6" r="2" fill="currentColor"/></svg>
                    Record
                </button>
                <div class="ctrl-sep"></div>
                <button class="ctrl-btn" onclick="toggleNight()" id="nightBtn">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 7A5 5 0 015 2a5 5 0 100 8 5 5 0 005-3z"/></svg>
                    Vision nuit
                </button>
                <button class="ctrl-btn" onclick="toggleGrid()" id="gridBtn">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="1" width="4" height="4"/><rect x="7" y="1" width="4" height="4"/><rect x="1" y="7" width="4" height="4"/><rect x="7" y="7" width="4" height="4"/></svg>
                    Grille
                </button>
                <button class="ctrl-btn" onclick="toggleFullscreen()" style="margin-left:auto;">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 4V1h3M8 1h3v3M11 8v3H8M4 11H1V8"/></svg>
                    Plein écran
                </button>
            </div>
        </div>

      
            
        <!-- RIGHT PANEL -->
        <div class="right-panel">
            <!-- STATS -->
            <div class="info-card">
                <div class="card-label">Statut Système</div>
                <div class="stat-row">
                    <div class="stat-item">
                        <div class="stat-lbl">Résolution</div>
                        <div class="stat-val blue">640p</div>
                    </div>
                    
            </div>

            <!-- ALERTS -->
            <div class="info-card">
                <div class="card-label">Événements récents</div>
                <div class="alert-item ok">
                    <div class="alert-dot"></div>
                    Caméra  connectée
                </div>
                <div class="alert-item info">
                    <div class="alert-dot"></div>
                    Stream démarré — port 5000
                </div>
                
            </div>

            
        </div>
    </div>
</div>

<script>
let zoom = 1;
let isRec = false;
let isNight = false;
let isGrid = false;

// CLOCK
setInterval(() => {
    const now = new Date();
    document.getElementById('timeTag').textContent =
        now.toLocaleTimeString('fr-FR');
}, 1000);

// PING simulation
setInterval(() => {
    const ping = Math.floor(20 + Math.random() * 40);
    document.getElementById('pingVal').textContent = ping + 'ms';
}, 3000);

function selectCam(e, num, name) {
    document.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
    e.currentTarget.classList.add('active');
    document.getElementById('camLabel').textContent = name;
    if (num === 1) {
        document.getElementById('camStream').src = 'http://192.168.0.155:5000/video';
        document.getElementById('fpsTag').textContent = '● SIGNAL OK';
    } else {
        document.getElementById('camStream').src = '';
        document.getElementById('fpsTag').textContent = '● HORS LIGNE';
    }
}

function zoomIn() {
    if (zoom < 3) { zoom = +(zoom + 0.2).toFixed(1); applyZoom(); }
}

function zoomOut() {
    if (zoom > 1) { zoom = +(zoom - 0.2).toFixed(1); applyZoom(); }
}

function applyZoom() {
    document.getElementById('camStream').style.transform = `scale(${zoom})`;
    document.getElementById('zoomTag').textContent = `ZOOM ${zoom.toFixed(1)}×`;
}

function takeSnapshot() {
    const now = new Date().toLocaleTimeString('fr-FR').replace(/:/g,'-');
    alert('📸 Snapshot enregistré — ' + now);
}

function toggleRecord() {
    isRec = !isRec;
    const btn = document.getElementById('recBtn');
    btn.classList.toggle('active', isRec);
    btn.innerHTML = isRec
        ? '<svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor"><rect x="2" y="2" width="8" height="8" rx="1"/></svg> Stop REC'
        : '<svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="6" cy="6" r="4"/><circle cx="6" cy="6" r="2" fill="currentColor"/></svg> Record';
}

function toggleNight() {
    isNight = !isNight;
    document.getElementById('camStream').style.filter =
        isNight ? 'brightness(0.5) sepia(0.8) hue-rotate(60deg)' : 'none';
    document.getElementById('nightBtn').classList.toggle('active', isNight);
}

function toggleGrid() {
    isGrid = !isGrid;
    const feed = document.getElementById('mainFeed');
    feed.style.backgroundImage = isGrid
        ? 'linear-gradient(rgba(192,57,43,0.15) 1px,transparent 1px),linear-gradient(90deg,rgba(192,57,43,0.15) 1px,transparent 1px)'
        : 'none';
    feed.style.backgroundSize = isGrid ? '60px 60px' : '';
    document.getElementById('gridBtn').classList.toggle('active', isGrid);
}

function toggleFullscreen() {
    const el = document.getElementById('mainFeed');
    if (!document.fullscreenElement) el.requestFullscreen();
    else document.exitFullscreen();
}

// KEYBOARD
document.addEventListener('keydown', e => {
    if (e.key === 'f' || e.key === 'F') toggleFullscreen();
    if (e.key === 's' || e.key === 'S') takeSnapshot();
    if (e.key === 'n' || e.key === 'N') toggleNight();
    if (e.key === 'r' || e.key === 'R') { zoom=1; applyZoom(); }
});
</script>

</body>
</html>