    </div>
</aside>

<!-- MAIN -->
<div class="main">
    <div class="topbar">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="#888" style="flex-shrink:0"><rect y="3" width="18" height="2"/><rect y="8" width="18" height="2"/><rect y="13" width="18" height="2"/></svg>
        <span class="topbar-title">Surveillance Caméras</span>
        <div class="topbar-right">
            <span class="admin-pill">ADMIN</span>
            <div class="live-pill"><div class="live-dot"></div>LIVE</div>
            <a href="/admin/notifications" class="topbar-bell">
                <svg width="18" height="18" viewBox="0 0 16 16" fill="#888"><path d="M8 1a5 5 0 00-5 5v3l-1.5 2.5h13L13 9V6a5 5 0 00-5-5zm0 14a2 2 0 01-2-2h4a2 2 0 01-2 2z"/></svg>
                <div class="bell-badge">3</div>
            </a>
            <a href="/admin/settings" class="topbar-user"><div class="user-dot"></div><%= user.name %></a>
        </div>
    </div>

    <div class="content">

        <!-- CAMERA MAIN -->
        <div class="cam-main">
            <div class="cam-header">
                <span class="cam-title">Flux Principal</span>
                <span class="cam-id" id="camLabel">CAM-01 — Entrée</span>
            </div>
            <div class="cam-feed" id="mainFeed">
                <img id="camStream" src="" style="width:100%;height:100%;object-fit:cover;display:block;">
                <div class="cam-offline-overlay" id="offlineOverlay">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.5"><path d="M1 4a1 1 0 011-1h8a1 1 0 011 1v1.5l3-2v7l-3-2V12a1 1 0 01-1 1H2a1 1 0 01-1-1V4z"/><line x1="2" y1="2" x2="22" y2="22" stroke="#e74c3c" stroke-width="2"/></svg>
                    CAMÉRA HORS LIGNE
                    <span style="font-size:0.7rem;color:#555;font-weight:400;">Reconnexion en cours...</span>
                </div>
                <div class="corner corner-tl"></div>
                <div class="corner corner-tr"></div>
                <div class="corner corner-bl"></div>
                <div class="corner corner-br"></div>
                <div class="cam-overlay-tl">
                    <div class="overlay-tag red"><div class="live-dot"></div> REC LIVE</div>
                    <div class="overlay-tag blue" id="resTag">640×480</div>
                </div>
                <div class="cam-overlay-tr">
                    <div class="overlay-tag" id="timeTag">--:--:--</div>
                </div>
                
                <div class="cam-overlay-br">
                    <div class="overlay-tag" id="zoomTag">ZOOM 1.0×</div>
                </div>
            </div>
            <div class="cam-controls">
                <button class="ctrl-btn" onclick="zoomIn()">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="5" cy="5" r="4"/><line x1="8" y1="8" x2="11" y2="11"/><line x1="5" y1="3" x2="5" y2="7"/><line x1="3" y1="5" x2="7" y2="5"/></svg>
                    Zoom +
                </button>
                <button class="ctrl-btn" onclick="zoomOut()">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="5" cy="5" r="4"/><line x1="8" y1="8" x2="11" y2="11"/><line x1="3" y1="5" x2="7" y2="5"/></svg>
                    Zoom −
                </button>
                <div class="ctrl-sep"></div>
                <button class="ctrl-btn" onclick="takeSnapshot()">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="10" height="8" rx="1"/><circle cx="6" cy="7" r="2"/><path d="M4 3l1-2h2l1 2"/></svg>
                    Snapshot
                </button>
                <button class="ctrl-btn danger" onclick="toggleRecord()" id="recBtn">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="6" cy="6" r="4"/><circle cx="6" cy="6" r="2" fill="currentColor"/></svg>
                    Record
                </button>
                <div class="ctrl-sep"></div>
                <button class="ctrl-btn" onclick="toggleNight()" id="nightBtn">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 7A5 5 0 015 2a5 5 0 100 8 5 5 0 005-3z"/></svg>
                    Vision nuit
                </button>
                <button class="ctrl-btn" onclick="toggleGrid()" id="gridBtn">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="1" width="4" height="4"/><rect x="7" y="1" width="4" height="4"/><rect x="1" y="7" width="4" height="4"/><rect x="7" y="7" width="4" height="4"/></svg>
                    Grille
                </button>
                <button class="ctrl-btn" onclick="toggleFullscreen()" style="margin-left:auto;">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 4V1h3M8 1h3v3M11 8v3H8M4 11H1V8"/></svg>
                    Plein écran
                </button>
            </div>
        </div>

        <!-- THUMBNAILS -->
      
          <div class="cam-overlay-bl">
              <div class="overlay-tag green" id="fpsTag">● SIGNAL OK</div>
         </div>
           

        <!-- RIGHT PANEL -->
        <div class="right-panel">
            <div class="info-card">
                <div class="card-label">Statut Caméra</div>
                <div class="stat-row-grid">
                    <div class="stat-item">
                        <div class="stat-lbl">Statut</div>
                        <div class="stat-val green" id="streamStatus">EN LIGNE</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-lbl">Résolution</div>
                        <div class="stat-val blue">640×480</div>
                    </div>
                

            <div class="info-card">
                <div class="card-label">Événements récents</div>
                <div class="alert-item ok">
                    <div class="alert-dot"></div>
                    Caméra connectée
                </div>
                <div class="alert-item info">
                    <div class="alert-dot"></div>
                    Stream démarré — port 5000
                </div>
                <div class="alert-item" id="camStatusAlert" style="background:rgba(39,174,96,0.07);border-color:rgba(39,174,96,0.2);color:#27ae60;">
                    <div class="alert-dot" style="background:#27ae60"></div>
                    <span id="camStatusText">Signal OK</span>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
let zoom = 1;
let isRec = false;
let isNight = false;
let isGrid = false;
let camOnline = false;
let retryTimer = null;

// ── CLOCK ──
setInterval(() => {
    const el = document.getElementById('timeTag');
    if (el) el.textContent = new Date().toLocaleTimeString('fr-FR');
}, 1000);

// Badel startCameraStream() f camera.ejs b haka:
let retryCount = 0;

function startCameraStream() {
    const img = document.getElementById('camStream');
    const overlay = document.getElementById('offlineOverlay');

    if (retryTimer) clearTimeout(retryTimer);

    // Cache-bust kol marra
    const newSrc = '/camera-stream?t=' + Date.now();

    img.onload = () => {
        camOnline = true;
        retryCount = 0;
        overlay.style.display = 'none';
        document.getElementById('fpsTag').textContent = '● SIGNAL OK';
        document.getElementById('fpsTag').className = 'overlay-tag green';
        const s = document.getElementById('streamStatus');
        if (s) { s.textContent = 'EN LIGNE'; s.className = 'stat-val green'; }
    };

    img.onerror = () => {
        camOnline = false;
        retryCount++;
        overlay.style.display = 'flex';
        document.getElementById('fpsTag').textContent = '● HORS LIGNE';
        document.getElementById('fpsTag').className = 'overlay-tag red';
        const s = document.getElementById('streamStatus');
        if (s) { s.textContent = 'HORS LIGNE'; s.className = 'stat-val rouge'; }

        // Backoff: 5s, 10s, 15s max
        const delay = Math.min(retryCount * 5000, 15000);
        console.warn(`Camera retry #${retryCount} dans ${delay/1000}s`);
        retryTimer = setTimeout(startCameraStream, delay);
    };

    img.src = newSrc;
}
// ── ZOOM ──
function zoomIn() {
    if (zoom < 3) { zoom = +(zoom + 0.2).toFixed(1); applyZoom(); }
}
function zoomOut() {
    if (zoom > 1) { zoom = +(zoom - 0.2).toFixed(1); applyZoom(); }
}
function applyZoom() {
    document.getElementById('camStream').style.transform = `scale(${zoom})`;
    document.getElementById('zoomTag').textContent = `ZOOM ${zoom.toFixed(1)}×`;
}

// ── SNAPSHOT ──
// Ba3d el /camera-stream route, zid haka:
app.get('/camera-snapshot', (req, res) => {
    const options = {
        hostname: '100.90.80.29',
        port: 5000,
        path: '/snapshot',  // walla '/video' — depends on camera_server.py
        method: 'GET',
        timeout: 10000
    };

    const proxyReq = http.request(options, (proxyRes) => {
        res.setHeader('Content-Type', 'image/jpeg');
        res.setHeader('Cache-Control', 'no-cache');
        proxyRes.pipe(res, { end: true });
    });

    proxyReq.on('error', (err) => {
        if (!res.headersSent) res.status(502).json({ error: 'Camera offline' });
    });

    proxyReq.on('timeout', () => {
        proxyReq.destroy();
        if (!res.headersSent) res.status(504).json({ error: 'Timeout' });
    });

    proxyReq.end();
});
// ── RECORD ──
function toggleRecord() {
    isRec = !isRec;
    const btn = document.getElementById('recBtn');
    btn.classList.toggle('active', isRec);
    btn.innerHTML = isRec
        ? '<svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor"><rect x="2" y="2" width="8" height="8" rx="1"/></svg> Stop REC'
        : '<svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="6" cy="6" r="4"/><circle cx="6" cy="6" r="2" fill="currentColor"/></svg> Record';
}

// ── NIGHT MODE ──
function toggleNight() {
    isNight = !isNight;
    document.getElementById('camStream').style.filter =
        isNight ? 'brightness(0.4) sepia(1) hue-rotate(90deg) saturate(2)' : 'none';
    document.getElementById('nightBtn').classList.toggle('active', isNight);
}

// ── GRID ──
function toggleGrid() {
    isGrid = !isGrid;
    const feed = document.getElementById('mainFeed');
    feed.style.backgroundImage = isGrid
        ? 'linear-gradient(rgba(192,57,43,0.15) 1px,transparent 1px),linear-gradient(90deg,rgba(192,57,43,0.15) 1px,transparent 1px)'
        : 'none';
    feed.style.backgroundSize = isGrid ? '60px 60px' : '';
    document.getElementById('gridBtn').classList.toggle('active', isGrid);
}

// ── FULLSCREEN ──
function toggleFullscreen() {
    const el = document.getElementById('mainFeed');
    if (!document.fullscreenElement) el.requestFullscreen().catch(()=>{});
    else document.exitFullscreen();
}

// ── SELECT CAM ──
function selectCam(e, num, name) {
    document.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
    e.currentTarget.classList.add('active');
    document.getElementById('camLabel').textContent = name;

    if (num === 1) {
        startCameraStream();
    } else {
        // Cameras 2,3,4 offline
        if (retryTimer) clearTimeout(retryTimer);
        const img = document.getElementById('camStream');
        img.src = '';
        document.getElementById('fpsTag').textContent = '● HORS LIGNE';
        document.getElementById('fpsTag').className = 'overlay-tag red';
        document.getElementById('offlineOverlay').style.display = 'flex';
        const statusEl = document.getElementById('streamStatus');
        if (statusEl) { statusEl.textContent = 'HORS LIGNE'; statusEl.className = 'stat-val rouge'; }
    }
}

// ── KEYBOARD ──
document.addEventListener('keydown', e => {
    if (e.key === 'f' || e.key === 'F') toggleFullscreen();
    if (e.key === 's' || e.key === 'S') takeSnapshot();
    if (e.key === 'n' || e.key === 'N') toggleNight();
    if (e.key === 'r' || e.key === 'R') { zoom = 1; applyZoom(); }
});
</script>

</body>
</html>