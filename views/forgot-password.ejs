<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="/js/theme.js"></script>
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/signin.css">
</head>

<body>
    <div class="signin-container">
        <!-- Left Panel -->
        <div class="left-panel">
            <div class="left-content">
                <div class="welcome-text-wrapper">
                    <h1 class="welcome-text">YURA GUARDIAN</h1>
                    <div class="text-decoration"></div>
                </div>
                <p class="robot-desc">Système de récupération de compte. Veuillez suivre les instructions pour
                    réinitialiser votre mot de passe.</p>

                <div class="features-vertical">
                    <div class="feature-item">
                        <span class="feature-icon"></span>
                        <p>Sécurité Garantie</p>
                    </div>
                </div>
            </div>

            <!-- Animated Background Left -->
            <div class="animated-bg-left">
                <div class="gradient-circle circle-1"></div>
                <div class="gradient-circle circle-2"></div>
            </div>
        </div>

        <!-- Right Panel -->
        <div class="right-panel">
            <!-- Animated Background Right -->
            <div class="animated-bg-right">
                <div class="gradient-circle circle-3"></div>
                <div class="gradient-circle circle-4"></div>
            </div>

            <div class="signin-box">
                <div class="header-section">
                    <div class="logo-title-row">
                        <div class="logo-wrapper">
                            <img src="/images/logo robot.png" alt="YURA GUARDIAN" class="signin-logo" loading="lazy">
                            <div class="logo-ring"></div>
                        </div>
                        <div class="header-text">
                            <h2 class="signin-title">Mot de passe oublié</h2>
                            <p class="signin-subtitle">Récupération de compte</p>
                        </div>
                    </div>
                </div>

                <% if (typeof error !=='undefined' && error) { %>
                    <div class="error-message">
                        <span class="error-icon">⚠️</span>
                        <span>
                            <%= error %>
                        </span>
                    </div>
                    <% } %>

                        <% if (typeof success !=='undefined' && success) { %>
                            <div class="error-message"
                                style="background: rgba(39, 174, 96, 0.15); border-color: rgba(39, 174, 96, 0.4); color: #27ae60;">
                                <span class="error-icon">✅</span>
                                <span>
                                    <%= success %>
                                </span>
                            </div>
                            <% } %>

                                <form action="/forgot-password" method="POST" class="signin-form" id="forgotForm">
                                    <!-- Email Field -->
                                    <div class="form-group">
                                        <label for="email" class="form-label">
                                            <span class="label-icon"></span>
                                            <span>Adresse email</span>
                                        </label>
                                        <div class="input-wrapper">
                                            <input type="email" id="email" name="email" required
                                                placeholder="exemple@yura.com" class="form-input">
                                            <span class="input-focus-border"></span>
                                        </div>
                                        <span class="input-hint">L'email associé à votre compte</span>
                                    </div>

                                    <!-- Submit Button -->
                                    <button type="submit" class="signin-btn" id="submitBtn">
                                        <span class="btn-text">Envoyer la demande</span>
                                        <span class="btn-arrow">→</span>
                                        <span class="btn-loader" style="display: none;">
                                            <span class="loader-dot"></span>
                                        </span>
                                    </button>

                                    <div style="margin-top: 20px; text-align: center;">
                                        <a href="/signin" class="forgot-link" style="font-size: 0.9rem;">Retour à la
                                            connexion</a>
                                    </div>
                                </form>
            </div>
        </div>
    </div>

    <script>
        // Form Submission Handler
        const forgotForm = document.getElementById('forgotForm');
        const submitBtn = document.getElementById('submitBtn');

        forgotForm.addEventListener('submit', function (e) {
            submitBtn.disabled = true;
            const btnText = submitBtn.querySelector('.btn-text');
            const btnLoader = submitBtn.querySelector('.btn-loader');

            btnText.style.opacity = '0';
            btnLoader.style.display = 'inline-block';
            submitBtn.style.pointerEvents = 'none';
        });

        // Real-time Input Validation
        const emailInput = document.getElementById('email');

        emailInput.addEventListener('input', function () {
            this.parentElement.parentElement.classList.add('filled');
        });

        emailInput.addEventListener('blur', function () {
            if (!this.value) {
                this.parentElement.parentElement.classList.remove('filled');
            }
        });

        // Auto-remove error message after 5 seconds
        const errorMsg = document.querySelector('.error-message');
        if (errorMsg && errorMsg.style.color !== 'rgb(39, 174, 96)') {
            setTimeout(() => {
                errorMsg.style.animation = 'slideOut 0.4s ease forwards';
                setTimeout(() => errorMsg.remove(), 400);
            }, 5000);
        }
    </script>
</body>

</html>