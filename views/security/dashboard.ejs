<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="/js/theme.js"></script>
    
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        :root {
            --rouge: #c0392b;
            --rouge-light: #e74c3c;
            --noir: #0a0a0a;
            --card: #111111;
            --card2: #161616;
            --border: rgba(192,57,43,0.18);
            --gris: #888;
            --gris2: #bbb;
        }
        body { font-family: 'Segoe UI', sans-serif; background: var(--noir); color: #fff; display: flex; min-height: 100vh; }

        .sidebar {
            width: 300px; min-height: 100vh;
            background: #0d0d0d;
            border-right: 1px solid var(--border);
            display: flex; flex-direction: column;
            position: fixed; top:0; left:0; bottom:0; z-index:100;
        }
        .logo-section {
            padding: 20px 18px;
            border-bottom: 1px solid var(--border);
            display: flex; align-items: center; gap: 14px;
        }
        .logo-name { font-size: 1.1rem; font-weight: 800; color: #fff; letter-spacing: 2px; }
        .logo-sub  { font-size: 0.65rem; color: var(--gris); letter-spacing: 2px; text-transform: uppercase; }

        .robot-badge {
            margin: 16px 16px 6px;
            padding: 11px 18px;
            background: rgba(192,57,43,0.15);
            border: 1px solid rgba(192,57,43,0.5);
            border-radius: 8px;
            display: flex; align-items: center; gap: 10px;
            font-size: 0.78rem; font-weight: 700;
            color: var(--rouge-light); letter-spacing: 1px;
        }
        .badge-dot {
            width: 9px; height: 9px;
            background: var(--rouge-light); border-radius: 50%;
            animation: blink 1.2s infinite;
            box-shadow: 0 0 6px rgba(231,76,60,0.8);
        }
        @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.15} }

        .nav-section { padding: 10px 0; flex:1; }
        .nav-label {
            font-size: 0.62rem; font-weight: 700; color: var(--gris);
            letter-spacing: 2px; padding: 14px 18px 6px; text-transform: uppercase;
        }
        .nav-item {
            display: flex; align-items: center; gap: 14px;
            padding: 12px 18px;
            color: #777; text-decoration: none;
            font-size: 0.9rem; font-weight: 500;
            border-left: 2px solid transparent;
            transition: all 0.18s; cursor: pointer;
        }
        .nav-item:hover { color: #fff; background: rgba(192,57,43,0.07); }
        .nav-item.active {
            color: #fff; background: rgba(192,57,43,0.13);
            border-left-color: var(--rouge); font-weight: 600;
        }
        .nav-icon-wrap { width: 22px; height: 22px; display: flex; align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0; }
        .nav-text { flex: 1; }
        .nav-count { background: var(--rouge); color: #fff; font-size: 0.65rem; font-weight: 700; padding: 3px 8px; border-radius: 12px; min-width: 22px; text-align: center; }

        .sidebar-footer { border-top: 1px solid var(--border); padding: 10px 0; }
        .user-row { display: flex; align-items: center; gap: 11px; padding: 12px 18px; }
        .user-av { width: 36px; height: 36px; background: linear-gradient(135deg, var(--rouge), #7b241c); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; font-weight: 700; flex-shrink: 0; }
        .user-name-s { font-size: 0.85rem; font-weight: 600; color: #fff; }
        .user-role-s { font-size: 0.68rem; color: var(--gris); }

        .main-content { margin-left: 300px; flex: 1; display: flex; flex-direction: column; min-height: 100vh; }

        .top-bar {
            height: 52px; background: #0d0d0d;
            border-bottom: 1px solid var(--border);
            display: flex; align-items: center;
            padding: 0 24px; gap: 14px;
            position: sticky; top:0; z-index:50;
        }
        .topbar-title { font-size: 0.8rem; color: var(--gris); letter-spacing: 1.5px; text-transform: uppercase; flex:1; }
        .topbar-right { display: flex; align-items: center; gap: 14px; }
        .topbar-bell { font-size: 1.1rem; color: var(--gris); position: relative; cursor: pointer; text-decoration: none; display: flex; align-items: center; }
        .bell-badge { position: absolute; top:-4px; right:-4px; width:16px; height:16px; background: var(--rouge); border-radius: 50%; font-size: 0.6rem; color:#fff; font-weight:700; display: flex; align-items:center; justify-content:center; }
        .topbar-user { display: flex; align-items: center; gap: 7px; background: rgba(192,57,43,0.12); border: 1px solid rgba(192,57,43,0.35); padding: 5px 14px; border-radius: 20px; font-size: 0.78rem; font-weight: 600; color: var(--rouge-light); text-decoration: none; }
        .user-dot { width:7px; height:7px; background:var(--rouge-light); border-radius:50%; }

        .content { padding: 24px; flex:1; }

        .page-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 20px; }
        .page-header h1 { font-size: 1.9rem; font-weight: 800; color: #fff; }
        .page-header p  { font-size: 0.82rem; color: var(--gris); margin-top: 5px; }
        .live-badge { display: flex; align-items: center; gap: 8px; background: rgba(192,57,43,0.12); border: 1px solid rgba(192,57,43,0.4); padding: 9px 18px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; color: var(--rouge-light); letter-spacing: 1px; }
        .live-dot2 { width:8px; height:8px; background:var(--rouge-light); border-radius:50%; animation:blink 1.2s infinite; box-shadow:0 0 6px rgba(231,76,60,0.8); }

        .main-grid { display: grid; grid-template-columns: 1fr 320px; gap: 14px; }

        .cam-card { background: var(--card); border: 1px solid rgba(255,255,255,0.06); border-radius: 10px; overflow: hidden; }
        .cam-header { display: flex; align-items: center; justify-content: space-between; padding: 13px 16px; border-bottom: 1px solid rgba(255,255,255,0.05); }
        .cam-title { display: flex; align-items: center; gap: 9px; font-size: 0.85rem; font-weight: 700; color: var(--gris2); text-transform: uppercase; letter-spacing: 0.8px; }
        .rec-badge { display: flex; align-items: center; gap: 6px; font-size: 0.75rem; font-weight: 700; color: var(--rouge-light); letter-spacing: 1px; }
        .rec-dot2 { width:8px; height:8px; background:var(--rouge-light); border-radius:50%; animation:blink 0.9s infinite; }

        .cam-view { position: relative; background: #000; height: 340px; overflow: hidden; }
        .cam-view img { width:100%; height:100%; object-fit:cover; }
        .cam-view video { width:100%; height:100%; object-fit:cover; display:none; }
        .cam-corners { position:absolute; inset:0; pointer-events:none; z-index:2; }
        .corner { position:absolute; width:26px; height:26px; border-color:rgba(231,76,60,0.8); border-style:solid; }
        .corner-tl { top:14px; left:14px; border-width:2px 0 0 2px; }
        .corner-tr { top:14px; right:14px; border-width:2px 2px 0 0; }
        .corner-bl { bottom:40px; left:14px; border-width:0 0 2px 2px; }
        .corner-br { bottom:40px; right:14px; border-width:0 2px 2px 0; }
        .cam-timestamp { position:absolute; top:14px; right:14px; font-size:0.8rem; font-family:monospace; color:var(--rouge-light); z-index:3; }
        .cam-no-signal { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:10px; z-index:1; }
        .cam-no-signal p { font-size:0.82rem; color:rgba(255,255,255,0.2); }
        .cam-info-bar { position:absolute; bottom:0; left:0; right:0; padding:8px 14px; background:linear-gradient(transparent,rgba(0,0,0,0.75)); z-index:3; }
        .cam-info-text { font-size:0.72rem; color:rgba(192,57,43,0.9); font-family:monospace; }
        .cam-footer { padding: 10px 14px; border-top: 1px solid rgba(255,255,255,0.05); display: flex; gap: 8px; }
        .cam-btn { flex:1; padding:9px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 7px; color: #888; font-size:0.78rem; font-weight:600; cursor:pointer; transition:all 0.18s; }
        .cam-btn:hover { background:rgba(192,57,43,0.15); border-color:rgba(192,57,43,0.4); color:#fff; }
        .cam-btn.primary { background:rgba(192,57,43,0.2); border-color:rgba(192,57,43,0.5); color:var(--rouge-light); }

        .bottom-grid { display:grid; grid-template-columns:1fr 1fr 1fr; gap:14px; margin-top:14px; }

        .ctrl-card { background:var(--card); border:1px solid rgba(255,255,255,0.06); border-radius:10px; overflow:hidden; }
        .ctrl-header { display:flex; align-items:center; justify-content:space-between; padding:13px 16px; border-bottom:1px solid rgba(255,255,255,0.05); }
        .ctrl-title { font-size:0.85rem; font-weight:700; color:var(--gris2); text-transform:uppercase; letter-spacing:0.5px; }
        .ctrl-hint  { font-size:0.7rem; color:var(--gris); }
        .ctrl-body  { padding:16px; display:flex; flex-direction:column; align-items:center; }
        .dpad { display:grid; grid-template-columns:repeat(3,44px); grid-template-rows:repeat(3,44px); gap:6px; }
        .dpad-btn { width:44px; height:44px; background:var(--card2); border:1px solid rgba(255,255,255,0.08); border-radius:8px; color:#fff; font-size:1.1rem; font-weight:700; cursor:pointer; transition:all 0.15s; display:flex; align-items:center; justify-content:center; }
        .dpad-btn:hover { background:rgba(192,57,43,0.25); border-color:var(--rouge); }
        .dpad-btn:active { transform:scale(0.91); }
        .dpad-stop { background:rgba(192,57,43,0.2); border-color:rgba(192,57,43,0.6); color:var(--rouge-light); font-size:0.62rem; letter-spacing:0.5px; font-weight:800; }
        .dpad-stop:hover { background:var(--rouge); color:#fff; }
        .dpad-empty { width:44px; height:44px; }
        .cmd-status { text-align:center; font-size:0.78rem; color:#4ade80; height:18px; margin-top:10px; }

        /* ENV CARD */
        .env-card { background:var(--card); border:1px solid rgba(255,255,255,0.06); border-radius:10px; overflow:hidden; }
        .env-header { padding:13px 16px; border-bottom:1px solid rgba(255,255,255,0.05); font-size:0.85rem; font-weight:700; color:var(--gris2); text-transform:uppercase; letter-spacing:0.5px; display:flex; align-items:center; gap:8px; }
        .env-body { padding:12px 16px; display:flex; flex-direction:column; gap:10px; }
        .mini-stat { background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06); border-radius:8px; padding:10px 12px; }
        .mini-stat-label { font-size:0.65rem; color:var(--gris); text-transform:uppercase; letter-spacing:0.8px; margin-bottom:4px; }
        .mini-stat-val { font-size:1.1rem; font-weight:800; color:#fff; }
        .mini-stat-val.rouge { color:var(--rouge-light); }
        .mini-stat-val.green { color:#27ae60; }
        .mini-stat-val.orange { color:#f59e0b; }
        .progress-bar { height:4px; background:rgba(255,255,255,0.08); border-radius:2px; margin-top:6px; overflow:hidden; }
        .progress-fill { height:100%; border-radius:2px; transition:width 0.5s; }
        .progress-fill.rouge { background:var(--rouge); }
        .progress-fill.blue  { background:#3b82f6; }
        .progress-fill.green { background:#27ae60; }
        .progress-fill.orange{ background:#f59e0b; }

        .hist-card { background:var(--card); border:1px solid rgba(255,255,255,0.06); border-radius:10px; overflow:hidden; }
        .hist-header { display:flex; align-items:center; justify-content:space-between; padding:13px 16px; border-bottom:1px solid rgba(255,255,255,0.05); }
        .hist-title { font-size:0.85rem; font-weight:700; color:var(--gris2); text-transform:uppercase; letter-spacing:0.5px; }
        .hist-link  { font-size:0.75rem; color:var(--gris); text-decoration:none; transition:color 0.2s; }
        .hist-link:hover { color:var(--rouge-light); }
        .hist-body  { padding:6px 0; }
        .hist-item  { display:flex; align-items:center; gap:10px; padding:9px 16px; border-left:2px solid transparent; transition:all 0.15s; }
        .hist-item:hover { background:rgba(255,255,255,0.02); border-left-color:rgba(192,57,43,0.4); }
        .hist-time  { font-size:0.7rem; color:var(--gris); font-family:monospace; white-space:nowrap; flex-shrink:0; }
        .hist-action{ font-size:0.8rem; color:var(--gris2); }
        .hist-empty { font-size:0.82rem; color:var(--gris); text-align:center; padding:20px 0; }

        /* OBSTACLE TOAST */
        #obstacleAlert {
            display:none; position:fixed;
            top:60px; right:20px; z-index:9999;
            background:rgba(192,57,43,0.95);
            color:#fff; padding:12px 20px;
            border-radius:10px; font-weight:700; font-size:0.85rem;
            border:1px solid rgba(255,100,100,0.5);
        }
    </style>

    <script>
    (function(){
        try {
            const s = JSON.parse(localStorage.getItem('yuraSettings') || '{}');
            if (s.darkMode === false) {
                const st = document.createElement('style');
                st.id = '__yuraLight';
                st.textContent = `
                    body { background: #f0f2f5 !important; color: #111 !important; }
                    .sidebar { background: #fff !important; border-color: rgba(0,0,0,0.1) !important; }
                    .top-bar { background: #0d0d0d !important; }
                    .main-content, .content { background: #f0f2f5 !important; }
                    .cam-card, .ctrl-card, .env-card, .hist-card { background: #fff !important; border-color: rgba(0,0,0,0.08) !important; }
                    .mini-stat { background: #f5f5f5 !important; border-color: rgba(0,0,0,0.06) !important; }
                    .nav-item { color: #555 !important; }
                    .nav-item:hover { background: rgba(0,0,0,0.04) !important; color: #111 !important; }
                    .nav-item.active { color: var(--rouge) !important; background: rgba(192,57,43,0.07) !important; }
                    h1, .user-name-s, .logo-name { color: #111 !important; }
                    .logo-sub, .user-role-s, .topbar-title { color: #666 !important; }
                    .dpad-btn { background: #f0f0f0 !important; border-color: rgba(0,0,0,0.1) !important; color: #333 !important; }
                    .topbar-user { background: rgba(192,57,43,0.07) !important; border-color: rgba(192,57,43,0.2) !important; }
                    .robot-badge { background: rgba(192,57,43,0.07) !important; border-color: rgba(192,57,43,0.25) !important; }
                `;
                document.head.appendChild(st);
            }
            if (s.colorTheme === 'blue-black') {
                document.documentElement.style.setProperty('--rouge', '#2563eb');
                document.documentElement.style.setProperty('--rouge-light', '#3b82f6');
                document.documentElement.style.setProperty('--border', 'rgba(37,99,235,0.18)');
            } else if (s.colorTheme === 'green-black') {
                document.documentElement.style.setProperty('--rouge', '#16a34a');
                document.documentElement.style.setProperty('--rouge-light', '#22c55e');
                document.documentElement.style.setProperty('--border', 'rgba(22,163,74,0.18)');
            }
            if (s.animations === false) {
                const na = document.createElement('style');
                na.id = '__noAnim';
                na.textContent = '* { animation: none !important; transition: none !important; }';
                document.head.appendChild(na);
            }
        } catch(e) {}
    })();
    </script>
</head>
<body>

<div id="obstacleAlert"></div>

<!-- SIDEBAR -->
<aside class="sidebar">
    <div class="logo-section">
        <img src="/images/logo robot.png" alt="YURA" style="width:42px;height:42px;object-fit:contain;border-radius:8px;flex-shrink:0;">
        <div>
            <div class="logo-name">YURA</div>
            <div class="logo-sub">Guardian System</div>
        </div>
    </div>

    <div class="robot-badge">
        <div class="badge-dot"></div>
        <span>ROBOT EN LIGNE</span>
    </div>

    <div class="nav-section">
        <div class="nav-label">Contrôle</div>
        <a href="/dashboard/security" class="nav-item active">
            <span class="nav-icon-wrap"><svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><rect x="1" y="1" width="6" height="6" rx="1"/><rect x="9" y="1" width="6" height="6" rx="1"/><rect x="1" y="9" width="6" height="6" rx="1"/><rect x="9" y="9" width="6" height="6" rx="1"/></svg></span>
            <span class="nav-text">Dashboard</span>
        </a>
        <a href="/dashboard/camera" class="nav-item">
            <span class="nav-icon-wrap"><svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M1 4a1 1 0 011-1h8a1 1 0 011 1v1.5l3-2v7l-3-2V12a1 1 0 01-1 1H2a1 1 0 01-1-1V4z"/></svg></span>
            <span class="nav-text">Surveillance caméra</span>
        </a>
        <a href="/dashboard/map" class="nav-item">
            <span class="nav-icon-wrap"><svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M6 1l4 2 4-2v11l-4 2-4-2-4 2V3l4-2zm0 1.5L2 4.5v9l4-2 4 2 4-2v-9l-4 2-4-2z"/></svg></span>
            <span class="nav-text">Navigation</span>
        </a>
        <a href="/notifications" class="nav-item">
            <span class="nav-icon-wrap"><svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1a5 5 0 00-5 5v3l-1.5 2.5h13L13 9V6a5 5 0 00-5-5zm0 14a2 2 0 01-2-2h4a2 2 0 01-2 2z"/></svg></span>
            <span class="nav-text">Alertes</span>
            <span class="nav-count">3</span>
        </a>
        <a href="/dashboard/history" class="nav-item">
            <span class="nav-icon-wrap"><svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1a7 7 0 100 14A7 7 0 008 1zm0 2v5l3 3-1 1-3.5-3.5V3H8z"/></svg></span>
            <span class="nav-text">Historique</span>
        </a>
        <a href="/dashboard/settings" class="nav-item">
            <span class="nav-icon-wrap"><svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M7.5 1l-.8 2.4a5 5 0 00-1.4.8L3 3.5l-1.5 2.6 1.9 1.5a5 5 0 000 1.8L1.5 11l1.5 2.6 2.3-.8a5 5 0 001.4.8L7.5 16h1l.8-2.4a5 5 0 001.4-.8l2.3.8L14.5 11l-1.9-1.5a5 5 0 000-1.8l1.9-1.5L13 3.5l-2.3.7a5 5 0 00-1.4-.8L8.5 1h-1zM8 6a2 2 0 110 4A2 2 0 018 6z"/></svg></span>
            <span class="nav-text">Paramètres</span>
        </a>
    </div>

    <div class="sidebar-footer">
        <div class="user-row">
            <div class="user-av"><%= user.name.charAt(0).toUpperCase() %></div>
            <div>
                <div class="user-name-s"><%= user.name %></div>
                <div class="user-role-s"><%= user.role === 'admin' ? 'Administrateur' : 'Agent Sécurité' %></div>
            </div>
        </div>
        <a href="/logout" class="nav-item" style="color:#555;">
            <span class="nav-icon-wrap"><svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M6 2H3a1 1 0 00-1 1v10a1 1 0 001 1h3v-1.5H3.5v-9H6V2zm4.5 3.5L13 8l-2.5 2.5-1-1L11 8H6V6.5h5l-1.5-1.5 1-1z"/></svg></span>
            <span class="nav-text">Déconnexion</span>
        </a>
    </div>
</aside>

<!-- MAIN -->
<div class="main-content">
    <div class="top-bar">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="#888" style="flex-shrink:0"><rect y="3" width="18" height="2"/><rect y="8" width="18" height="2"/><rect y="13" width="18" height="2"/></svg>
        <span class="topbar-title">Système de Surveillance</span>
        <div class="topbar-right">
            <a href="/notifications" class="topbar-bell">
                <svg width="18" height="18" viewBox="0 0 16 16" fill="#888"><path d="M8 1a5 5 0 00-5 5v3l-1.5 2.5h13L13 9V6a5 5 0 00-5-5zm0 14a2 2 0 01-2-2h4a2 2 0 01-2 2z"/></svg>
                <div class="bell-badge">3</div>
            </a>
            <a href="/dashboard/settings" class="topbar-user">
                <div class="user-dot"></div><%= user.name %>
            </a>
        </div>
    </div>

    <div class="content">
        <div class="page-header">
            <div>
                <h1>Dashboard Agent de sécurité</h1>
                <p>Contrôle en temps réel du robot de surveillance</p>
            </div>
            <div class="live-badge">
                <div class="live-dot2"></div>
                EN DIRECT
            </div>
        </div>

        <!-- MAIN GRID: Camera + right panel -->
        <div class="main-grid">
            <!-- CAMERA -->
            <div class="cam-card">
                <div class="cam-header">
                    <div class="cam-title">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="#c0392b"><path d="M8 3C4 3 1 8 1 8s3 5 7 5 7-5 7-5-3-5-7-5zm0 8a3 3 0 110-6 3 3 0 010 6zm0-5a2 2 0 100 4 2 2 0 000-4z"/></svg>
                        Caméra Principale
                    </div>
                    <div class="rec-badge">
                        <div class="rec-dot2"></div>
                        REC
                    </div>
                </div>
                
                <div class="cam-view" id="camView">
                    <div class="cam-corners">
                        <div class="corner corner-tl"></div>
                        <div class="corner corner-tr"></div>
                        <div class="corner corner-bl"></div>
                        <div class="corner corner-br"></div>
                    </div>
                    <div class="cam-timestamp" id="camTime">--:--:--</div>
                    <div class="cam-no-signal" id="camNoSignal">
                        <p style="font-size:2.5rem;opacity:0.1;">📹</p>
                        <p>En attente du signal...</p>
                    </div>
                    <img id="camImg" alt="" style="width:100%;height:100%;object-fit:cover;display:none;">
                    <div class="cam-info-bar">
                        <span class="cam-info-text">CAM-01 | YURA-001 | LIVE</span>
                    </div>
                </div>
                <div class="cam-footer">
                    <button class="cam-btn primary" onclick="startCam()">▶ Activer</button>
                    <button class="cam-btn" onclick="stopCam()">■ Stop</button>
                    <button class="cam-btn" onclick="takeSnap()">📸 Capture</button>
                    <button class="cam-btn" onclick="goFull()">⛶ Plein</button>
                </div>
            </div>

            <!-- RIGHT: Historique -->
            <div class="hist-card">
                <div class="hist-header">
                    <span class="hist-title">Historique</span>
                    <a href="/dashboard/history" class="hist-link">Voir tout →</a>
                </div>
                <div class="hist-body">
                    <% if(histories && histories.length > 0){ %>
                        <% histories.slice(0,10).forEach(function(h){ %>
                            <div class="hist-item">
                                <div class="hist-time"><%= new Date(h.timestamp).toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'}) %></div>
                                <div class="hist-action"><%= h.action %></div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="hist-empty">Aucun historique</div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- BOTTOM GRID -->
        <div class="bottom-grid">
            <!-- CONTROLS -->
            <div class="ctrl-card">
                <div class="ctrl-header">
                    <span class="ctrl-title">Contrôle Robot</span>
                    <span class="ctrl-hint">Flèches clavier</span>
                </div>
                <div class="ctrl-body">
                    <div class="dpad">
                        <div class="dpad-empty"></div>
                        <button class="dpad-btn" onclick="sendCmd('Forward')">↑</button>
                        <div class="dpad-empty"></div>
                        <button class="dpad-btn" onclick="sendCmd('Left')">←</button>
                        <button class="dpad-btn dpad-stop" onclick="sendCmd('STOP')">STOP</button>
                        <button class="dpad-btn" onclick="sendCmd('Right')">→</button>
                        <div class="dpad-empty"></div>
                        <button class="dpad-btn" onclick="sendCmd('Backward')">↓</button>
                        <div class="dpad-empty"></div>
                    </div>
                    <div class="cmd-status" id="cmdStatus"></div>
                </div>
            </div>

            <!-- ENV — Température + Humidité + Obstacle -->
            <div class="env-card">
                <div class="env-header">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="#e74c3c"><path d="M7 0a2 2 0 00-2 2v6.17A3 3 0 107 13.9V2a2 2 0 00-2-2z" opacity="0.4"/><rect x="6" y="2" width="2" height="5" rx="1"/><circle cx="7" cy="11" r="2"/></svg>
                    Environnement
                </div>
                <div class="env-body">
                    <div class="mini-stat">
                        <div class="mini-stat-label">Batterie</div>
                        <div class="mini-stat-val orange" id="bat">52%</div>
                        <div class="progress-bar">
                            <div class="progress-fill orange" id="batBar" style="width:52%"></div>
                        </div>
                    </div>
                    <div class="mini-stat">
                        <div class="mini-stat-label">Température</div>
                        <div class="mini-stat-val rouge" id="temp">--°C</div>
                        <div class="progress-bar">
                            <div class="progress-fill rouge" id="tempBar" style="width:0%"></div>
                        </div>
                    </div>
                    <div class="mini-stat">
                        <div class="mini-stat-label">Humidité</div>
                        <div class="mini-stat-val green" id="hum">--%</div>
                        <div class="progress-bar">
                            <div class="progress-fill blue" id="humBar" style="width:0%"></div>
                        </div>
                    </div>
                    <div class="mini-stat">
                        <div class="mini-stat-label">Obstacle</div>
                        <div class="mini-stat-val green" id="obstacleVal">Aucun</div>
                    </div>
                    <div class="mini-stat">
                        <div class="mini-stat-label">Distance</div>
                        <div class="mini-stat-val" style="color:#3b82f6;" id="distVal">-- cm</div>
                    </div>
                </div>
            </div>

            <!-- HISTORIQUE bottom -->
            <div class="hist-card">
                <div class="hist-header">
                    <span class="hist-title">Dernières alertes</span>
                    <a href="/notifications" class="hist-link">Voir tout →</a>
                </div>
                <div class="hist-body">
                    <% if(histories && histories.length > 0){ %>
                        <% histories.filter(h => h.action && h.action.toLowerCase().includes('obstacle')).slice(0,5).forEach(function(h){ %>
                            <div class="hist-item">
                                <div class="hist-time"><%= new Date(h.timestamp).toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'}) %></div>
                                <div class="hist-action" style="color:#e74c3c;"><%= h.action %></div>
                            </div>
                        <% }); %>
                        <% if(histories.filter(h => h.action && h.action.toLowerCase().includes('obstacle')).length === 0){ %>
                            <div class="hist-empty">Aucune alerte</div>
                        <% } %>
                    <% } else { %>
                        <div class="hist-empty">Aucune alerte</div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // TIME
    function tick() { document.getElementById('camTime').textContent = new Date().toLocaleTimeString('fr-FR'); }
    tick(); setInterval(tick, 1000);

    // CAMERA — stream RPi via /camera-stream proxy
    let _camRetryTimer = null, _camRetryCount = 0;

    function startCam() {
        const img   = document.getElementById('camImg');
        const noSig = document.getElementById('camNoSignal');
        if (!img) return;

        if (_camRetryTimer) clearTimeout(_camRetryTimer);

        img.onload = () => {
            _camRetryCount = 0;
            noSig.style.display = 'none';
            img.style.display   = 'block';
        };

        img.onerror = () => {
            _camRetryCount++;
            img.style.display   = 'none';
            noSig.style.display = 'flex';
            const delay = Math.min(_camRetryCount * 5000, 15000);
            console.warn(`Dash cam retry #${_camRetryCount} dans ${delay/1000}s`);
            _camRetryTimer = setTimeout(startCam, delay);
        };

        img.src = '/camera-stream?t=' + Date.now();
    }

    function stopCam() {
        if (_camRetryTimer) clearTimeout(_camRetryTimer);
        const img   = document.getElementById('camImg');
        const noSig = document.getElementById('camNoSignal');
        if (img) { img.src = ''; img.style.display = 'none'; }
        if (noSig) noSig.style.display = 'flex';
        _camRetryCount = 0;
    }

    function takeSnap() {
        const img = document.getElementById('camImg');
        if (!img || !img.src) return;
        const a = document.createElement('a');
        a.download = 'yura-snap-' + Date.now() + '.png';
        a.href = img.src; a.click();
    }

    function goFull() {
        const el = document.getElementById('camView');
        if (el.requestFullscreen) el.requestFullscreen();
        else if (el.webkitRequestFullscreen) el.webkitRequestFullscreen();
    }

    window.onload = () => startCam();

    // ROBOT COMMANDS — agent yab3ath nafs route ta3 admin
    const cmdMap = {
        'Forward':  'forward',
        'Backward': 'backward',
        'Left':     'right',
        'Right':    'left',
        'STOP':     'stop'
    };

    function sendCmd(cmd) {
        const arduinoCmd = cmdMap[cmd] || cmd.toLowerCase();

        fetch('/admin/robot/command', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ command: arduinoCmd, speed: 128 })
        })
        .then(r => r.json())
        .then(res => console.log('🤖 Agent cmd:', arduinoCmd, res))
        .catch(e => console.log('❌ Robot error:', e));

        const msgs = {
            Forward:'⬆ Avancer', Backward:'⬇ Reculer',
            Left:'⬅ Gauche', Right:'➡ Droite', STOP:'🛑 Arrêt'
        };
        const s = document.getElementById('cmdStatus');
        if (s) { s.textContent = msgs[cmd] || cmd; setTimeout(() => s.textContent = '', 2000); }
    }

    document.addEventListener('keydown', e => {
        if (e.key === 'ArrowUp')    { e.preventDefault(); sendCmd('Forward'); }
        if (e.key === 'ArrowDown')  { e.preventDefault(); sendCmd('Backward'); }
        if (e.key === 'ArrowLeft')  { e.preventDefault(); sendCmd('Left'); }
        if (e.key === 'ArrowRight') { e.preventDefault(); sendCmd('Right'); }
        if (e.key === ' ')          { e.preventDefault(); sendCmd('STOP'); }
    });

    // SENSORS
    function updateSensors() {
        fetch('/api/sensors')
            .then(r => r.json())
            .then(res => {
                const d = res.data;

                const b = parseFloat(d.battery);
                if (!isNaN(b) && b > 0) {
                    document.getElementById('bat').textContent = b + '%';
                    document.getElementById('batBar').style.width = Math.min(b, 100) + '%';
                } else {
                    document.getElementById('bat').textContent = '52%';
                    document.getElementById('batBar').style.width = '52%';
                }

                const t = parseFloat(d.temperature !== undefined ? d.temperature : d.temp);
                if (!isNaN(t)) {
                    document.getElementById('temp').textContent = t.toFixed(1) + '°C';
                    document.getElementById('tempBar').style.width = Math.min(t * 2, 100) + '%';
                }

                const h = parseFloat(d.humidity !== undefined ? d.humidity : d.hum);
                if (!isNaN(h)) {
                    document.getElementById('hum').textContent = h.toFixed(1) + '%';
                    document.getElementById('humBar').style.width = Math.min(h, 100) + '%';
                }

                const dist = parseFloat(d.distance);
                if (!isNaN(dist)) {
                    document.getElementById('distVal').textContent = dist.toFixed(0) + ' cm';
                }

                const obsEl = document.getElementById('obstacleVal');
                if (d.obstacle === true) {
                    obsEl.textContent = '🚨 Détecté';
                    obsEl.className = 'mini-stat-val rouge';
                    let alertEl = document.getElementById('obstacleAlert');
                    alertEl.textContent = '🚨 OBSTACLE — ' + (isNaN(dist) ? '?' : dist.toFixed(0)) + ' cm';
                    alertEl.style.display = 'block';
                    clearTimeout(window._obsTimer);
                    window._obsTimer = setTimeout(() => { alertEl.style.display = 'none'; }, 3000);
                } else {
                    obsEl.textContent = 'Aucun';
                    obsEl.className = 'mini-stat-val green';
                    document.getElementById('obstacleAlert').style.display = 'none';
                }
            })
            .catch(err => console.log('Sensor error:', err));
    }

    setInterval(updateSensors, 2000);
    updateSensors();
</script>
</body>
</html>